<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.Chat"
             Title="Chat">
    <Grid RowDefinitions="*,Auto" Padding="10">

        <CollectionView x:Name="MensajesList" Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" CornerRadius="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding Emisor}" FontAttributes="Bold"/>
                            <Label Text="{Binding Texto}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Entry x:Name="MensajeEntry" Placeholder="Escribe un mensaje..." HorizontalOptions="FillAndExpand"/>
            <Button Text="Enviar" Clicked="OnEnviarClicked"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>