<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.Chat"
             BackgroundColor="White">

    <VerticalStackLayout Padding="10" Spacing="10">

        <CollectionView x:Name="MensajesList"
                        ItemsSource="{Binding Mensajes}"
                        VerticalOptions="FillAndExpand">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Padding="10"
                           Margin="5"
                           CornerRadius="15"
                           HasShadow="True"
                           BackgroundColor="{Binding EsMio, Converter={StaticResource EscribirBoolColor}}"
                           HorizontalOptions="{Binding EsMio, Converter={StaticResource EscribirBool}}">

                        <VerticalStackLayout>

                            <Label Text="{Binding Texto}"
                                   LineBreakMode="WordWrap"/>

                            <Label Text="{Binding Hora}"
                                   FontSize="10"
                                   HorizontalOptions="End"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <HorizontalStackLayout Spacing="10">

            <Entry x:Name="MensajeEntry"
                   Placeholder="Escribe un mensaje..."
                   HorizontalOptions="FillAndExpand"/>

            <Button Text="Enviar"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="OnEnviarClicked"/>

        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>