<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.Ranking"
             Title="Ranking">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Ranking de Jugadores"
               FontSize="26"
               HorizontalOptions="Center"
               FontAttributes="Bold"/>

        <CollectionView x:Name="RankingList">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Padding="15"
                           Margin="5"
                           CornerRadius="12"
                           HasShadow="True"
                           BackgroundColor="White">

                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding Posicion}" Value="1">
                                <Setter Property="BackgroundColor" Value="#FFD700"/>
                            </DataTrigger>

                            <DataTrigger TargetType="Frame" Binding="{Binding Posicion}" Value="2">
                                <Setter Property="BackgroundColor" Value="#C0C0C0"/>
                            </DataTrigger>

                            <DataTrigger TargetType="Frame" Binding="{Binding Posicion}" Value="3">
                                <Setter Property="BackgroundColor" Value="#CD7F32"/>
                            </DataTrigger>
                        </Frame.Triggers>

                        <Grid ColumnDefinitions="60,*,80">

                            <Label Text="{Binding Posicion}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="1"
                                   Text="{Binding Nombre}"
                                   FontSize="18"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="2"
                                   Text="{Binding Puntos}"
                                   FontSize="18"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"/>

                        </Grid>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>