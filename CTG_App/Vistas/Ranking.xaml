<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.Ranking"
             BackgroundColor="White">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Ranking de Jugadores"
               FontSize="30"
               TextColor="Purple"
               HorizontalOptions="Center"/>

        <CollectionView x:Name="RankingList">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame CornerRadius="15"
                           Padding="15"
                           Margin="5"
                           HasShadow="True"
                           BackgroundColor="White">

                        <Grid ColumnDefinitions="50,*,Auto">

                            <Label Text="{Binding Posicion}"
                                   FontSize="20"
                                   TextColor="Purple"/>

                            <Label Grid.Column="1"
                                   Text="{Binding Nombre}"
                                   FontAttributes="Bold"/>

                            <Label Grid.Column="2"
                                   Text="{Binding Victorias}"
                                   TextColor="Green"/>

                        </Grid>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>