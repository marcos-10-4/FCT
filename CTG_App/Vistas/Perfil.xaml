<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.Perfil"
             Title="Mi Perfil">

    <VerticalStackLayout Padding="30" Spacing="15">

        <Label Text="Mi Perfil" FontSize="28" HorizontalOptions="Center"/>

        <Label x:Name="NombreLabel"/>
        <Label x:Name="EmailLabel"/>

        <Label Text="--- Estadísticas ---" FontSize="18"/>

        <Label x:Name="PuntosLabel"/>
        <Label x:Name="PartidosLabel"/>
        <Label x:Name="VictoriasLabel"/>
        <Label x:Name="DerrotasLabel"/>

    </VerticalStackLayout>

</ContentPage>