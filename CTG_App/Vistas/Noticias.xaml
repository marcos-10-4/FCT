<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.Noticias"
             Title="Noticias"
             BackgroundColor="White"
             Padding="15">

    <ScrollView>

        <VerticalStackLayout Spacing="20">

            <!-- TITULO -->
            <Label Text="Noticias del Club"
                   FontSize="30"
                   TextColor="Purple"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- NOTICIA DESTACADA -->
            <Frame CornerRadius="20"
                   HasShadow="True"
                   Padding="0"
                   BackgroundColor="White">

                <VerticalStackLayout>

                    <Image Source="{Binding NoticiaDestacada.Imagen}"
                           HeightRequest="180"
                           Aspect="AspectFill"/>

                    <VerticalStackLayout Padding="15">

                        <Label Text="{Binding NoticiaDestacada.Titulo}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="Purple"/>

                        <Label Text="{Binding NoticiaDestacada.Fecha}"
                               FontSize="12"
                               TextColor="Gray"/>

                        <Label Text="{Binding NoticiaDestacada.Contenido}"
                               FontSize="16"
                               LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Frame>

            <!-- LISTA DE NOTICIAS -->
            <CollectionView ItemsSource="{Binding OtrasNoticias}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Frame CornerRadius="15"
                               Margin="5"
                               Padding="10"
                               HasShadow="True"
                               BackgroundColor="White">

                            <HorizontalStackLayout Spacing="10">

                                <Image Source="{Binding Imagen}"
                                       WidthRequest="70"
                                       HeightRequest="70"
                                       Aspect="AspectFill"/>

                                <VerticalStackLayout>

                                    <Label Text="{Binding Titulo}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="Purple"
                                           LineBreakMode="WordWrap"/>

                                    <Label Text="{Binding Fecha}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                    <Label Text="{Binding Contenido}"
                                           FontSize="14"
                                           LineBreakMode="WordWrap"
                                           MaxLines="4"/>

                                </VerticalStackLayout>

                            </HorizontalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>