<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.MenuPrincipal"
             x:Name="Page"
             Title="Menú Principal"
             BackgroundColor="White"
             Padding="20">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="20">

        <!-- Título -->
        <Label Grid.Row="0"
               Text="Bienvenido"
               FontSize="30"
               TextColor="Purple"
               HorizontalOptions="Center"
               FontAttributes="Bold"/>

        <!-- Tarjeta botones -->
        <Frame Grid.Row="1"
               CornerRadius="20"
               Padding="20"
               BackgroundColor="White"
               HasShadow="True">

            <VerticalStackLayout Spacing="15">

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">

                    <Button Text="Perfil"
                            BackgroundColor="Green"
                            TextColor="White"
                            Clicked="OnPerfilClicked"/>

                    <Button Text="Partido"
                            x:Name="BtnRegistrarPartido"
                            BackgroundColor="Green"
                            TextColor="White"
                            Clicked="OnPartidoClicked"/>

                    <Button Text="Noticias"
                            BackgroundColor="Purple"
                            TextColor="White"
                            Clicked="OnNoticiasClicked"/>

                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">

                    <Button Text="Ranking"
                            BackgroundColor="Purple"
                            TextColor="White"
                            Clicked="OnRankingClicked"/>

                    <Button Text="Cerrar sesión"
                            BackgroundColor="#B71C1C"
                            TextColor="White"
                            Clicked="OnLogoutClicked"/>

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Frame>

        <!-- Texto -->
        <Label Grid.Row="2"
               Text="Selecciona un usuario para chatear:"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="Purple"/>

        <!-- Lista de usuarios -->
        <CollectionView Grid.Row="3"
                        x:Name="UsuariosList"
                        SelectionChanged="OnUsuarioSeleccionado"
                        SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Padding="15"
                           Margin="6"
                           CornerRadius="15"
                           HasShadow="True"
                           BackgroundColor="White">

                        <HorizontalStackLayout Spacing="10">

                            <!-- Icono -->
                            <Label Text="👤"
                                   FontSize="20"/>

                            <!-- Nombre -->
                            <Label Text="{Binding Nombre}"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   HorizontalOptions="StartAndExpand"/>

                            <!-- Botón eliminar (visible solo para admin) -->
                            <Button Text="Eliminar"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    Clicked="OnEliminarUsuarioClicked"
                                    IsVisible="{Binding Source={x:Reference Page}, Path=IsAdmin}"/>

                        </HorizontalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>