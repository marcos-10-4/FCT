<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.Registro"
             Title="Registro">

    <ScrollView>

        <VerticalStackLayout Padding="30"
                             Spacing="20"
                             VerticalOptions="Center">

            <Label 
                Text="Crear cuenta"
                FontSize="28"
                HorizontalOptions="Center"
                FontAttributes="Bold"/>

            <Entry
                x:Name="NombreEntry"
                Placeholder="Nombre"/>

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                Keyboard="Email"/>

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Contraseña"
                IsPassword="True"/>

            <Button
                Text="Registrarse"
                Clicked="OnRegisterClicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>