<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CTG_App.Vistas.RegistrarPartido"
             Title="Registrar Partido">
    
    <VerticalStackLayout Padding="30" Spacing="15">

        <Label Text="Registrar Partido" FontSize="24"/>

        <Picker x:Name="Jugador1Picker" Title="Jugador 1"/>
        <Picker x:Name="Jugador2Picker" Title="Jugador 2"/>
        <Picker x:Name="GanadorPicker" Title="Ganador"/>

        <Button Text="Guardar Partido" Clicked="OnGuardarClicked"/>

    </VerticalStackLayout>

</ContentPage>